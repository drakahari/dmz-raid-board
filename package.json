{
  "name": "dmz-raid-board",
  "version": "0.1.10-field-upgrades.1",
  "description": "Offline DMZ item planner and raid checklist",
  "private": true,
  "license": "MIT",
  "main": "dist/main/main.cjs",
  "author": "Private prototype",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/core.test.mjs tests/catalog.test.mjs tests/simple-wanted.test.mjs tests/field-upgrades.test.mjs tests/themes.test.mjs tests/data-path.test.mjs tests/version.test.mjs tests/target-core.test.mjs tests/catalog-update018.test.mjs",
    "test:ui": "npm run build && node tests/electron.test.mjs",
    "package": "node scripts/package-local.mjs",
    "build:public": "tsc -p tsconfig.json && node scripts/build.mjs --public",
    "package:public": "node scripts/package-local.mjs --public",
    "build:artwork": "tsc -p tsconfig.json && node scripts/build.mjs --with-artwork",
    "package:artwork": "node scripts/package-local.mjs --with-artwork",
    "package:candidate": "node scripts/package-local.mjs --with-artwork",
    "test:catalog-ui": "npm run build && node tests/season-ui.test.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "@playwright/test": "1.64.1"
  },
  "build": {
    "appId": "private.dmz.raidboard",
    "productName": "DMZ Raid Board",
    "directories": {
      "output": "release/0.1.10-field-upgrades.1-local"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "CATALOG.md",
      "README.md",
      "docs/SEASON-1-EVIDENCE.md",
      "docs/SEASON-1-UPDATE.md",
      "docs/season1-printer-audit.json",
      "docs/IMAGE-SOURCES-2026-11-06.json",
      "docs/IMAGE-UPDATE-2026-11-06.md",
      "docs/SIMPLE-WANTED-UPDATE.md",
      "docs/FIELD-UPGRADES-UPDATE.md"
    ],
    "asar": true,
    "win": {
      "target": "zip",
      "signExecutable": false,
      "artifactName": "DMZ-Raid-Board-${version}-win-x64-portable-private-candidate.zip",
      "icon": "branding/dmz-icon.png"
    },
    "extraFiles": [
      {
        "from": "dist/THIRD-PARTY-ARTWORK.md",
        "to": "THIRD-PARTY-ARTWORK.md"
      },
      {
        "from": "dist/ARTWORK-SOURCES.json",
        "to": "ARTWORK-SOURCES.json"
      },
      {
        "from": "LICENSE",
        "to": "APP-LICENSE.txt"
      },
      {
        "from": "THEMES.md",
        "to": "THEMES.md"
      },
      {
        "from": "theme-notices",
        "to": "theme-notices"
      }
    ]
  }
}
