{
  "name": "dmz-raid-board",
  "version": "0.1.6",
  "description": "Offline DMZ item planner and raid checklist",
  "private": true,
  "license": "MIT",
  "main": "dist/main/main.cjs",
  "author": "Private prototype",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/core.test.mjs",
    "test:ui": "npm run build && node tests/electron.test.mjs",
    "package": "npm run build && electron-builder --win zip --x64",
    "build:public": "tsc -p tsconfig.json && node scripts/build.mjs --public",
    "package:public": "npm run build:public && electron-builder --win zip --x64 --config.directories.output=release/0.1.6-public --config.win.artifactName=DMZ-Raid-Board-0.1.6-win-x64-portable-public.zip",
    "build:artwork": "tsc -p tsconfig.json && node scripts/build.mjs --with-artwork",
    "package:artwork": "npm run build:artwork && electron-builder --win zip --x64 --config.directories.output=release/0.1.6-with-artwork --config.win.artifactName=DMZ-Raid-Board-0.1.6-win-x64-portable-with-artwork.zip",
    "package:candidate": "npm run build:artwork && electron-builder --win zip --x64 --config.directories.output=release/0.1.6-candidate --config.win.artifactName=DMZ-Raid-Board-0.1.6-win-x64-settings-themes-candidate.zip"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "@playwright/test": "1.64.1"
  },
  "build": {
    "appId": "private.dmz.raidboard",
    "productName": "DMZ Raid Board",
    "directories": {
      "output": "release/0.1.6-private"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "CATALOG.md",
      "README.md"
    ],
    "asar": true,
    "win": {
      "target": "zip",
      "signExecutable": false,
      "artifactName": "DMZ-Raid-Board-${version}-win-x64-portable-private-candidate.zip",
      "icon": "branding/dmz-icon.png"
    },
    "extraFiles": [
      {
        "from": "dist/THIRD-PARTY-ARTWORK.md",
        "to": "THIRD-PARTY-ARTWORK.md"
      },
      {
        "from": "dist/ARTWORK-SOURCES.json",
        "to": "ARTWORK-SOURCES.json"
      },
      {
        "from": "LICENSE",
        "to": "APP-LICENSE.txt"
      },
      {
        "from": "THEMES.md",
        "to": "THEMES.md"
      },
      {
        "from": "theme-notices",
        "to": "theme-notices"
      }
    ]
  }
}
