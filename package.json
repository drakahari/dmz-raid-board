{
  "name": "dmz-raid-board",
  "version": "0.1.1",
  "description": "Private offline DMZ raid planning prototype",
  "private": true,
  "license": "MIT",
  "main": "dist/main/main.cjs",
  "author": "Private prototype",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/core.test.mjs",
    "test:ui": "npm run build && node tests/electron.test.mjs",
    "package": "npm run build && electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "@playwright/test": "1.64.1"
  },
  "build": {
    "appId": "private.dmz.raidboard",
    "productName": "DMZ Raid Board",
    "directories": { "output": "release/0.1.1" },
    "files": ["dist/**/*", "package.json", "CATALOG.md", "README.md"],
    "asar": true,
    "win": { "target": "zip", "signExecutable": false, "artifactName": "DMZ-Raid-Board-${version}-win-x64-portable-candidate.zip" }
  }
}
